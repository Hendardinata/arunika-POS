PORT=3001
# Isi dengan nilai acak, mis: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost/NAMA_DB?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
UPLOAD_FOLDER=app/static/uploads
# Opsional. Folder berkas .bak. Kosongkan untuk memakai backups/ di dalam
# folder aplikasi; kalau diisi, folder itu harus bisa DITULIS layanan SQL
# Server dan DIBACA proses Flask.
DB_BACKUP_DIR=
FLASK_ENV=development

# --- Hanya untuk docker compose ---
# Auth key dari https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# Sama dengan DATABASE_URL, tapi host-nya host.docker.internal: dari dalam
# container, "localhost" adalah container itu sendiri, bukan SQL Server di host.
DOCKER_DATABASE_URL=mssql+pyodbc://USER:PASSWORD@host.docker.internal:1433/NAMA_DB?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
