generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The url is omitted to support Prisma driver adapters.
  // The connection string is provided when instantiating PrismaClient in src/db.ts
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("CASHIER") // ADMIN, HEADBAR, or CASHIER
  createdAt DateTime @default(now())
}

model SystemSettings {
  id                  Int      @id @default(autoincrement())
  key                 String   @unique // e.g., "POINT_EXPIRATION_DAYS"
  value               String   // e.g., "90"
  description         String?
  updatedAt           DateTime @updatedAt
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  menus Menu[]
}

model Menu {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  price            Int
  imageUrl         String?
  category         Category          @relation(fields: [categoryId], references: [id])
  categoryId       Int
  transactionItems TransactionItem[]
}

model Customer {
  id               Int             @id @default(autoincrement())
  nickname         String          @unique
  points           Int             @default(0)
  pointsExpiryDate DateTime?
  xp               Int             @default(0)
  level            Int             @default(1)
  lastVisitDate    DateTime?
  streakCount      Int             @default(0)
  transactions     Transaction[]
  quests           CustomerQuest[]
  badges           CustomerBadge[]
  createdAt        DateTime        @default(now())
}

model Transaction {
  id           Int               @id @default(autoincrement())
  totalAmount  Int
  pointsEarned Int
  paymentMethod String           @default("CASH")
  customer     Customer          @relation(fields: [customerId], references: [id])
  customerId   Int
  items        TransactionItem[]
  createdAt    DateTime          @default(now())
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId Int
  menu          Menu        @relation(fields: [menuId], references: [id])
  menuId        Int
  quantity      Int
  price         Int
}

model Reward {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  type           String   @default("NORMAL") // NORMAL, MYSTERY_BOX, LUCKY_SPIN
  pointsRequired Int
  active         Boolean  @default(true)
}

model Quest {
  id           Int             @id @default(autoincrement())
  name         String
  description    String?
  type           String          @default("TOTAL_TRANSACTIONS")
  targetEntityId Int?
  targetValue    Int
  rewardPoints   Int             @default(0)
  rewardXp     Int             @default(0)
  active       Boolean         @default(true)
  isDaily      Boolean         @default(false)
  customers    CustomerQuest[]
}

model CustomerQuest {
  id          Int      @id @default(autoincrement())
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  Int
  quest       Quest    @relation(fields: [questId], references: [id])
  questId     Int
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([customerId, questId])
}

model Badge {
  id                   Int             @id @default(autoincrement())
  name                 String
  description          String?
  iconUrl              String?
  requiredTransactions Int             @default(0)
  customers            CustomerBadge[]
}

model CustomerBadge {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  badge      Badge    @relation(fields: [badgeId], references: [id])
  badgeId    Int
  unlockedAt DateTime @default(now())

  @@unique([customerId, badgeId])
}

model InventoryItem {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  stock       Int               @default(0)
  unit        String            @default("pcs")
  imageUrl    String?
  logs        InventoryLog[]
  opnameItems DailyOpnameItem[]
}

model DailyOpname {
  id        Int               @id @default(autoincrement())
  date      DateTime          @default(now())
  status    String            @default("OPEN") // OPEN, CLOSED
  items     DailyOpnameItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model DailyOpnameItem {
  id                 Int           @id @default(autoincrement())
  opname             DailyOpname   @relation(fields: [opnameId], references: [id])
  opnameId           Int
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId    Int
  openingStock       Int           @default(0)
  closingStock       Int?
  used               Int?
  morningNotes       String?
  nightNotes         String?
}

model InventoryLog {
  id        Int           @id @default(autoincrement())
  item      InventoryItem @relation(fields: [itemId], references: [id])
  itemId    Int
  quantity  Int
  type      String        // "IN" or "OUT"
  notes     String?
  createdAt DateTime      @default(now())
}
